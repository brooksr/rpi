# Copy to .env (gitignored) and fill in. scripts/config.sh exports these, and
# install scripts fill @@NAME@@ placeholders from them when staging files.

# Pi connection and LAN
PI_USER=pi
PI_HOST=raspberrypi.local
PI_IP_ETH=192.168.1.50          # eth0, pin with a DHCP reservation
PI_IP_WIFI=192.168.1.51         # wlan0 fallback
PI_MAC_ETH=
PI_MAC_WIFI=
LAN_SUBNET=192.168.1            # first three octets of the /24
GATEWAY=192.168.1.1             # router; local-net-status pings it
TAILNET_HOST=raspberrypi.example-tailnet.ts.net   # Tailscale HTTPS name
# HA_HOST=homeserver.local             # Home Assistant host if not the Pi (Pi-hole and BabySteps stay on the Pi)
# HA_USER=                      # defaults to PI_USER
HA_IP=192.168.1.20             # HA host's LAN IP, for links phones open (Android can't resolve .local)
TV_IP=192.168.1.10             # Samsung TV, filtered by pihole-tv-*.sql
ALLOW_DOMAIN=                   # work domain verify-pihole.sh expects allowed

# Local Map (home location and household)
HOME_LAT=34.1764                # decimal degrees
HOME_LON=-118.8489
HOME_STREET="Main Street"       # street-sweeping reminder text
PSPS_CIRCUIT=EXAMPLE            # SCE circuit name for power shutoff status
CHILD_NAME=Baby                 # Today timeline bedtime item

# Recipes
RECIPE_BOOK_TITLE="Family Recipe Book"
RECIPES_DOC_URL=https://docs.google.com/document/d/YOUR_DOC_ID/edit
